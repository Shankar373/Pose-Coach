{
  "name": "pose-coach",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pose Coach — real-time photography direction and dotted pose guidance",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seeds": "tsx eval/seed-sheet.ts",
    "eval": "tsx eval/run.ts",
    "eval:mock": "tsx eval/run.ts --mock",
    "server": "tsx server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && npm run server",
    "smoke": "tsx scripts/smoke.ts",
    "cf:login": "npx wrangler@latest login",
    "cf:d1:create": "npx wrangler@latest d1 create pose-coach-limits",
    "cf:d1:migrate": "npx wrangler@latest d1 execute pose-coach-limits --remote --file=./migrations/0001_request_limits.sql",
    "cf:dev": "npm run build && npx wrangler@latest dev",
    "cf:deploy": "npm run build && npx wrangler@latest deploy",
    "vercel-build": "node scripts/unpack-project.mjs && npm run typecheck && npm run build",
    "dev:vercel": "vercel dev",
    "test:ci": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  }
}
